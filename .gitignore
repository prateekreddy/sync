node_modules/
dist/
*.tsbuildinfo

# Secrets — never commit. `.env` has no slash, so it matches at any depth,
# including deploy/.env which holds every credential the stack uses.
.env
.env.*
!.env.example

# Plane's self-host artefacts, if you ever run its own setup.sh alongside. The
# stack in deploy/docker-compose.yml does not need them.
deploy/plane/

# Local npm tuning (sandbox network workarounds) — not project config
.npmrc

# Per-host Compose override. The README tells you to write one of these to run
# behind a reverse proxy you already own, and its contents are specific to that
# host: which ports are free, which network the outer proxy sits on, what memory
# the box can spare. Committing one would push a single machine's layout onto
# every other deployment.
deploy/docker-compose.override.yml

# Python bytecode from running the deploy scripts locally. `plane_api.pyc` was
# committed by accident in fe75fd3; it is a build output of a script that only
# ever runs as `python3 plane_api.py`.
__pycache__/
*.pyc
