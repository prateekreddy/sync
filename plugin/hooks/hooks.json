{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__sync__claim",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sync-session harvest"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "resume|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sync-session report"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sync-session close"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "${CLAUDE_PLUGIN_ROOT}/bin/sync-session fence"
          }
        ]
      }
    ]
  }
}
