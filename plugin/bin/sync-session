#!/usr/bin/env bash
#
# The four moments the gateway cannot see for itself.
#
# The gateway knows everything about a lease except what is happening to the
# agent holding it. It cannot tell a session ending from an agent thinking, and
# it cannot see git at all. These hooks supply exactly those facts and nothing
# else -- every one of them is an accelerator, and the gateway's own timeout
# remains the guarantee. That layering is deliberate: a hook that fails must cost
# latency, never correctness, because hooks do not run when a process is killed.
#
#   harvest  after claim   -- capture the watch URL for the monitor
#   report   on resume     -- say what is still held, so a restored session knows
#   close    on session end-- hand back what is still held
#   fence    before push   -- refuse to publish work the lease no longer covers
#
# Hook input arrives as JSON on stdin. Every path here exits 0 unless it means to
# block, because a hook that errors on an unrelated failure would wedge the agent
# for a reason that has nothing to do with it.
set -uo pipefail

CMD="${1:-}"
# shellcheck source=./sync-paths.sh
SYNC_BIN="$(dirname "$0")"
. "$SYNC_BIN/sync-paths.sh"
STATE_DIR=$(sync_state_dir)
mkdir -p "$STATE_DIR" 2>/dev/null || true

input=$(cat 2>/dev/null || true)
# Portable across jq / node / python3 -- see bin/sync-json. No hard dependency,
# because a missing helper would disable the fence silently.
# Quiet on purpose: `preflight` is the one place that reports a missing parser,
# once per session. Letting every hook invocation shout would be noise people
# learn to scroll past, which is how a real warning gets missed.
jqr() { printf '%s' "$input" | "$SYNC_BIN/sync-json" "$1" 2>/dev/null; }
get() { printf '%s' "$1" | "$SYNC_BIN/sync-json" "$2" 2>/dev/null; }

# Hook input first, environment second -- resolved in sync-paths.sh, because the
# monitor has to arrive at the same filename and cannot see this stdin.
#
# There is deliberately no third fallback. A per-process name was tried, and it
# is unreachable by construction: the monitor is a different process, so a name
# built from this one's pid is a file only the writer can find. Better to hold
# nothing than to hold it somewhere nobody looks.
SESSION=$(sync_session_id "$(jqr '.session_id')")
WATCH_FILE=$([ -n "$SESSION" ] && sync_watch_file "$SESSION")

case "$CMD" in
  preflight)
    # Checked once per session rather than per hook. A missing parser makes the
    # fence and the session bracket inert, and an inert guard that nobody knows
    # is inert is worse than no guard -- you push stale work believing something
    # checked it.
    if ! printf '{"ok":1}' | "$SYNC_BIN/sync-json" ok >/dev/null 2>&1; then
      echo "sync is degraded: no JSON parser found, so the push fence and session tracking are OFF."
      echo "Install jq to restore them:  brew install jq   |   apt-get install -y jq"
    fi
    # The other way this goes inert, and the one that used to be invisible. With
    # no session id the hook and the monitor have no filename to agree on, so the
    # lease is kept alive by nothing. Said here rather than at each hook: this
    # runs once per session, and it is the same reason the parser check lives
    # here -- a guard nobody knows is off is worse than no guard.
    if [ -z "$SESSION" ]; then
      echo "sync is degraded: this session has no id (CLAUDE_CODE_SESSION_ID is unset), so"
      echo "your claim will NOT be kept alive and may lapse while you are still working."
    fi
    ;;

  harvest)
    # `claim` is the one call an agent must make, so it is the one place a
    # credential can be handed over without adding an obligation. The model never
    # sees this happen and cannot forget to do it.
    [ -n "$WATCH_FILE" ] || exit 0

    # A tool result reaches a hook in more than one shape, and which one is not
    # something this script gets to decide. The MCP form is a CallToolResult
    # whose payload is a JSON *string* inside a content block; the REST and stdio
    # paths hand back the object itself; structured output puts it in a field of
    # its own. Reading only the first of those is what shipped, and it found
    # nothing for as long as the hook existed.
    #
    # So try them in order rather than betting on one. Each is cheap, and the
    # alternative is a guess whose failure is total and silent.
    url=$(jqr '.tool_response.watchUrl')
    for path in \
      '.tool_response.structuredContent.watchUrl' \
      '.tool_response.content.0.text' \
      '.tool_response.0.text' \
      '.tool_response'
    do
      case "$url" in ''|null) ;; *) break ;; esac
      candidate=$(jqr "$path")
      case "$candidate" in
        ''|null) continue ;;
        # A URL already, from the structured field.
        http*) url="$candidate" ;;
        # Otherwise it is JSON carrying one, and needs a second parse.
        *) url=$(get "$candidate" watchUrl) ;;
      esac
    done

    if [ -n "$url" ] && [ "$url" != "null" ]; then
      # 0600: possession of this URL is authorisation. Its powers are small --
      # extend this session's leases and report them -- but small is not none.
      umask 077
      printf '%s' "$url" > "$WATCH_FILE"
    else
      # This hook only runs after a claim, and a claim always returns a watch
      # URL. Finding none means the result arrived in a shape none of the above
      # matched -- so say so. Staying quiet here is what let the whole chain sit
      # broken: the lease then lapses on the ordinary timer, an hour later,
      # looking like nothing to do with this.
      echo "sync: could not read the watch URL from this claim, so your lease will NOT be kept alive."
      echo "sync: it will lapse on its own timer and another agent may take the item. Please report this."
    fi
    ;;

  report)
    # A resumed or compacted session has no memory of what it holds. Rather than
    # trusting the agent to call `held` -- the same "remember to do it later" that
    # produced the original bug -- state it up front, where it cannot be skipped.
    [ -r "$WATCH_FILE" ] || exit 0
    tmp="$STATE_DIR/.report.$$"
    # Through sync_poll, so the rotation this GET causes is kept. Reporting used
    # to discard it and leave the credential dead behind it.
    code=$(sync_poll "$WATCH_FILE" "$tmp")
    body=$(cat "$tmp" 2>/dev/null); rm -f "$tmp"
    [ "$code" = "200" ] || exit 0
    held=$(get "$body" holding)
    [ -n "$held" ] && echo "You are still holding $held. Resume it or release it."
    ;;

  close)
    # Best-effort by design. This does not fire on a crash or a killed terminal,
    # which is exactly why the gateway's timeout has to be the real guarantee --
    # this only makes the common case fast.
    [ -r "$WATCH_FILE" ] || exit 0
    curl -fsS -m 10 -X DELETE "$(cat "$WATCH_FILE")" >/dev/null 2>&1 || true
    rm -f "$WATCH_FILE"
    ;;

  fence)
    # Scope decided here rather than in hooks.json.
    #
    # That file declares `"if": "Bash(git push*)"` next to the matcher, and the
    # intent reads clearly, but it does not gate: measured 2026-08-10, commands
    # containing no git and no push were run through this branch. Two costs, and
    # the first is severe -- a credential the gateway no longer recognises made
    # the fence deny EVERYTHING, so an agent could not run a single shell command
    # and was told its work had been taken; and every Bash call paid an HTTP
    # round trip with a ten second timeout for a check irrelevant to it.
    #
    # Getting the declarative syntax right is not the fix. A guard that fails
    # open on its own scope is the same class of defect as the matcher that
    # never matched, and the way out is the same: decide it where it is
    # enforced, from the command actually being run.
    #
    # `push` has to be git's SUBCOMMAND, not merely a word near it. The first
    # cut looked for git and push anywhere in the command and fenced
    # `git commit -m "push the button"` and `cat notes-about-git-push.md` --
    # which is how a guard meant for one command ends up blocking a working day.
    #
    # So: git at a command boundary (start, or after a separator -- never after
    # `-` or `/`, which is what excludes the filename), then optionally its own
    # options and their values, then push as the next word.
    #
    #   git push                    git push --force origin main
    #   git -C /repo push           npm test && git push
    #
    # Still generous where it is cheap: a false positive costs one request, a
    # false negative is the collision this whole design exists to prevent.
    boundary='(^|[;&|(]|[[:space:]])'
    option='-[^[:space:]]+[[:space:]]+([^-][^[:space:]]*[[:space:]]+)?'
    cmd=$(jqr '.tool_input.command')
    printf '%s' "$cmd" \
      | grep -Eq "${boundary}git[[:space:]]+(${option})*push([[:space:]]|$)" || exit 0

    # The lease protects the gateway's bookkeeping; it cannot stop an agent
    # writing files. A push is where private work becomes everyone else's
    # problem, so it is the last cheap moment to stop a stale holder.
    #
    # What this does NOT do, stated here because the previous wording claimed it
    # did and somebody would eventually rely on that. This hook runs on
    # PreToolUse and there is no PostToolUse on Bash at all, so:
    #
    #   poll -> answer -> allow -> git push runs -> published
    #           ^ verdict formed                    ^ nothing revisits it
    #
    # The check and the publish are not atomic and no PreToolUse hook can make
    # them so. Measured 2026-08-10: the poll alone takes ~350ms, so the verdict
    # is already that stale before git starts, and the push itself took ~2.5s as
    # a DRY RUN against a warm remote -- longer for a real pack or a cold link.
    #
    # So this catches a holder that lost the item BEFORE it pushed, not one that
    # loses it DURING. That is still worth having: it shrinks the exposure from
    # unbounded -- a stale holder pushing hours later, which is the 2026-08-04
    # collision that motivated all of this -- to about one push. It is a
    # narrowing, not a guarantee, and calling it a guarantee is how somebody ends
    # up trusting it for the case it cannot cover. See SYNC-116.
    #
    # The distinction that matters is between a verdict and ignorance:
    #
    #   410  the gateway says this work is definitively not yours. Another
    #        session claimed the item, which cleared this credential. REFUSE.
    #   200  it answered; obey `stale`.
    #   any  we could not ask. Allow, and say so -- a network failure must never
    #   else make it impossible to push, or the guard becomes the outage.
    [ -r "$WATCH_FILE" ] || exit 0
    tmp="$STATE_DIR/.fence.$$"
    # Through sync_poll for the same reason: a fence that polls and drops the
    # rotation leaves the next fence refusing a push that was always legitimate.
    code=$(sync_poll "$WATCH_FILE" "$tmp")
    body=$(cat "$tmp" 2>/dev/null); rm -f "$tmp"

    deny() {
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":%s}}\n' \
        "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')"
      exit 0
    }

    case "$code" in
      410)
        deny "This work is no longer yours -- another session claimed it, or the lease was revoked. Do not push. Discard this work and re-claim if you still want the item."
        ;;
      401)
        # The credential aged out while the machine was away. Ignorance, not a
        # verdict, so it must ALLOW -- and this is exactly the distinction the
        # `410 means stop` rule is built on. It arrived as 410 until SYNC-104,
        # which meant a laptop opened after a long weekend refused every push and
        # told the agent its work had been taken.
        #
        # Not silent, though, because the lease really has stopped being kept
        # alive and the agent should re-claim before it does much more.
        echo "sync: your lease credential expired while you were away, so the lease could not be checked -- allowing this push. Nobody has taken your work; call 'held' and re-claim the item if you mean to carry on." >&2
        ;;
      200)
        if [ "$(get "$body" stale)" = "true" ]; then
          reason=$(get "$body" say)
          [ -n "$reason" ] || reason="Your lease has lapsed or was revoked. Do not push this work."
          deny "$reason"
        fi
        ;;
      *)
        echo "sync: could not reach the gateway to check your lease; allowing the push unchecked." >&2
        ;;
    esac
    ;;

esac

exit 0
