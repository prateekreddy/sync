#!/usr/bin/env bash
#
# The four moments the gateway cannot see for itself.
#
# The gateway knows everything about a lease except what is happening to the
# agent holding it. It cannot tell a session ending from an agent thinking, and
# it cannot see git at all. These hooks supply exactly those facts and nothing
# else -- every one of them is an accelerator, and the gateway's own timeout
# remains the guarantee. That layering is deliberate: a hook that fails must cost
# latency, never correctness, because hooks do not run when a process is killed.
#
#   harvest  after claim   -- capture the watch URL for the monitor
#   report   on resume     -- say what is still held, so a restored session knows
#   close    on session end-- hand back what is still held
#   fence    before push   -- refuse to publish work the lease no longer covers
#
# Hook input arrives as JSON on stdin. Every path here exits 0 unless it means to
# block, because a hook that errors on an unrelated failure would wedge the agent
# for a reason that has nothing to do with it.
set -uo pipefail

CMD="${1:-}"
STATE_DIR="${SYNC_STATE_DIR:-$HOME/.claude/sync}"
mkdir -p "$STATE_DIR" 2>/dev/null || true

input=$(cat 2>/dev/null || true)
# Portable across jq / node / python3 -- see bin/sync-json. No hard dependency,
# because a missing helper would disable the fence silently.
# Quiet on purpose: `preflight` is the one place that reports a missing parser,
# once per session. Letting every hook invocation shout would be noise people
# learn to scroll past, which is how a real warning gets missed.
jqr() { printf '%s' "$input" | "$(dirname "$0")/sync-json" "$1" 2>/dev/null; }
get() { printf '%s' "$1" | "$(dirname "$0")/sync-json" "$2" 2>/dev/null; }

# Hook input first, environment second. The fallback matters more than it looks:
# it named CLAUDE_SESSION_ID, which is not a variable Claude Code sets, so every
# hook that could not parse its stdin quietly agreed on the session "default" --
# and two windows both called "default" share one watch file, which is precisely
# the confusion between concurrent sessions this design removes. A wrong name
# fails silently here; there is no error, only a wrong answer.
SESSION=$(jqr '.session_id')
case "$SESSION" in
  ''|null) SESSION="${CLAUDE_CODE_SESSION_ID:-}" ;;
esac
# Still nothing: use a per-process name rather than a shared one. Being unable to
# group this session's state is a small loss; merging it with an unrelated
# session's is a real one.
[ -n "$SESSION" ] || SESSION="pid-$PPID"
WATCH_FILE="$STATE_DIR/$SESSION.watch"

case "$CMD" in
  preflight)
    # Checked once per session rather than per hook. A missing parser makes the
    # fence and the session bracket inert, and an inert guard that nobody knows
    # is inert is worse than no guard -- you push stale work believing something
    # checked it.
    if ! printf '{"ok":1}' | "$(dirname "$0")/sync-json" ok >/dev/null 2>&1; then
      echo "sync is degraded: no JSON parser found, so the push fence and session tracking are OFF."
      echo "Install jq to restore them:  brew install jq   |   apt-get install -y jq"
    fi
    ;;

  harvest)
    # `claim` is the one call an agent must make, so it is the one place a
    # credential can be handed over without adding an obligation. The model never
    # sees this happen and cannot forget to do it.
    url=$(jqr '.tool_response.watchUrl')
    if [ -n "$url" ] && [ "$url" != "null" ]; then
      # 0600: possession of this URL is authorisation. Its powers are small --
      # extend this session's leases and report them -- but small is not none.
      umask 077
      printf '%s' "$url" > "$WATCH_FILE"
    fi
    ;;

  report)
    # A resumed or compacted session has no memory of what it holds. Rather than
    # trusting the agent to call `held` -- the same "remember to do it later" that
    # produced the original bug -- state it up front, where it cannot be skipped.
    [ -r "$WATCH_FILE" ] || exit 0
    body=$(curl -fsS -m 10 "$(cat "$WATCH_FILE")" 2>/dev/null) || exit 0
    held=$(get "$body" holding)
    [ -n "$held" ] && echo "You are still holding $held. Resume it or release it." 
    ;;

  close)
    # Best-effort by design. This does not fire on a crash or a killed terminal,
    # which is exactly why the gateway's timeout has to be the real guarantee --
    # this only makes the common case fast.
    [ -r "$WATCH_FILE" ] || exit 0
    curl -fsS -m 10 -X DELETE "$(cat "$WATCH_FILE")" >/dev/null 2>&1 || true
    rm -f "$WATCH_FILE"
    ;;

  fence)
    # The lease protects the gateway's bookkeeping; it cannot stop an agent
    # writing files. A push is where private work becomes everyone else's
    # problem, so it is the last cheap moment to stop a stale holder -- and the
    # only one that would have prevented the collision this design exists to fix.
    #
    # The distinction that matters is between a verdict and ignorance:
    #
    #   410  the gateway says this work is definitively not yours. Another
    #        session claimed the item, which cleared this credential. REFUSE.
    #   200  it answered; obey `stale`.
    #   any  we could not ask. Allow, and say so -- a network failure must never
    #   else make it impossible to push, or the guard becomes the outage.
    [ -r "$WATCH_FILE" ] || exit 0
    tmp="$STATE_DIR/.fence.$$"
    code=$(curl -sS -m 10 -o "$tmp" -w '%{http_code}' "$(cat "$WATCH_FILE")" 2>/dev/null) || code=000
    body=$(cat "$tmp" 2>/dev/null); rm -f "$tmp"

    deny() {
      printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":%s}}\n' \
        "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/')"
      exit 0
    }

    case "$code" in
      410)
        deny "This work is no longer yours -- another session claimed it, or the lease was revoked. Do not push. Discard this work and re-claim if you still want the item."
        ;;
      200)
        if [ "$(get "$body" stale)" = "true" ]; then
          reason=$(get "$body" say)
          [ -n "$reason" ] || reason="Your lease has lapsed or was revoked. Do not push this work."
          deny "$reason"
        fi
        ;;
      *)
        echo "sync: could not reach the gateway to check your lease; allowing the push unchecked." >&2
        ;;
    esac
    ;;

esac

exit 0
