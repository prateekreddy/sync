#!/usr/bin/env bash
#
# Keeps a claim alive without the agent having to remember anything.
#
# The heartbeat used to be the agent's job: call it periodically or lose the
# lease. That failed exactly as you would expect -- an agent worked for an hour
# without calling it, the lease lapsed, another agent took the item, and the two
# collided. An obligation that comes due *later* is one a model will eventually
# drop, because it has no clock and forgets its own history at every compaction.
#
# So liveness moved here. This is a process, not a promise: Claude Code starts it
# with the session and it dies with the session. It has no opinions and cannot be
# talked out of running.
#
# It also solves the case no hook can see. Closing a laptop fires no event -- the
# session neither ends nor restarts, it suspends. This process suspends with it
# and resumes with it, so the first poll after a gap *is* the resume signal, and
# the gateway can say "your lease lapsed but the item is still free, reinstated"
# or "someone else took it, stop and discard".
#
# Deliberately dumb. It re-reads the credential every pass rather than caching it,
# which is what makes it self-healing: rotate the URL, expire it, mint a new one
# after a long sleep -- the next pass picks it up with no restart and no
# coordination. Nothing here needs to be maintained, which is the point.
set -uo pipefail

# The credential is a capability URL: possession is authorisation, and it can do
# exactly two things -- extend this session's leases and report their state. It
# cannot claim, complete, capture, or read a work item. That is why a generous
# lifetime is safe, and why this file only needs to be user-readable rather than
# guarded like a password.
# shellcheck source=./sync-paths.sh
SYNC_BIN="$(dirname "$0")"
. "$SYNC_BIN/sync-paths.sh"
TOKEN_DIR=$(sync_state_dir)

# The monitor has no hook stdin, so the environment is the only thing it and the
# writer can both see. This used to read CLAUDE_SESSION_ID -- a variable Claude
# Code does not set -- and fall back to `default.watch`, so it polled a file
# nothing ever writes and kept nothing alive, quietly, forever.
SESSION=$(sync_session_id)
if [ -z "$SESSION" ]; then
  # Nothing this process can do will work, so say so once and stop rather than
  # looping on a filename that cannot exist. Sitting here polling would be the
  # original bug with extra steps: a monitor that looks alive and guarantees
  # nothing.
  echo "sync: this session has no id, so your claim cannot be kept alive. It may lapse while you work."
  exit 0
fi
WATCH_FILE=$(sync_watch_file "$SESSION")

INTERVAL="${SYNC_POLL_SECONDS:-120}"
# Backoff is per-process and resets on any success. A gateway that is down must
# not turn into a poll every two seconds from every open session.
BACKOFF=0
MAX_BACKOFF=900

# Has this plugin been updated out from under this process?
#
# Claude Code starts a monitor once per session and freezes CLAUDE_PLUGIN_ROOT at
# that moment, so it keeps running from the version directory that was current
# when the session began. Hooks do NOT work this way -- they are invoked fresh
# per event and resolve the install each time -- so an update produces a session
# with current hooks and a stale monitor, for as long as that session lives.
#
# Measured 2026-08-10, minutes after an update to 0.4.4:
#
#   agent 2712840 09:55 bash .../sync/0.2.0/bin/sync-monitor
#   agent 3301396 10:21 bash .../sync/0.4.4/bin/sync-monitor
#
# Two of them, from versions four releases apart, and nothing reaps the old one.
# 0.2.0 predates the shared-path fix entirely: it polls `default.watch`, a file
# nothing writes, forever, while looking perfectly healthy in `ps`. Anyone
# debugging liveness sees a monitor running and concludes the chain is up, which
# is the exact failure 904f33b was about.
#
# The real hazard is not the version number, it is the credential file: it is a
# mutable protocol shared between the monitor and the hooks, and eeee49c changed
# that protocol. A stale monitor writing under old rules corrupts a credential
# the current hooks depend on, and the failure lands as "your work is no longer
# yours" -- the one direction this must never fail in.
#
# So stop rather than carry on. That is only a safe trade because the gateway now
# reports a monitor it has not heard from (SYNC-100): a session left with no
# monitor is told so on its next claim, in words, rather than discovering it an
# hour later. Silence would not have been safe before that landed.
INSTALLED_JSON="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json"
MY_ROOT=$(cd "$SYNC_BIN/.." 2>/dev/null && pwd -P)

# The version now installed in place of this one, or nothing. Silent and
# conservative by construction: any doubt at all -- no record, unreadable file,
# no entry sharing our parent directory -- answers "carry on". A monitor that
# stops when it did not have to is worse than one that runs a release behind.
# Has this plugin been deleted out from under this process?
#
# Separate from `superseded` because it is not a judgement call and needs no
# external file. `superseded` is deliberately conservative and answers "carry on"
# whenever it cannot read Claude Code's private state -- which is exactly the
# case the other box hit on 2026-08-10: a monitor alive for 44 minutes from
# .../cache/sync/sync/0.4.7/bin/sync-monitor while the whole plugins/cache tree
# was gone and installed_plugins.json did not exist. It polled happily from a
# path that no longer existed, and a reinstall started a second one beside it.
#
# A process whose own bin directory has been deleted has been uninstalled. The
# script is already parsed and the sourced functions are in memory, so it goes on
# running perfectly well -- which is the whole problem.
uninstalled() {
  [ -n "$MY_ROOT" ] && [ ! -d "$MY_ROOT/bin" ]
}

superseded() {
  [ -n "$MY_ROOT" ] && [ -r "$INSTALLED_JSON" ] || return 1
  paths=$(grep -o '"installPath"[[:space:]]*:[[:space:]]*"[^"]*"' "$INSTALLED_JSON" 2>/dev/null \
            | sed 's/.*"\(.*\)"$/\1/')
  [ -n "$paths" ] || return 1
  # Still installed under our own path: nothing to do.
  printf '%s\n' "$paths" | grep -qxF "$MY_ROOT" && return 1
  # Some other version of THIS plugin -- same parent directory, different leaf.
  newer=$(printf '%s\n' "$paths" | while IFS= read -r p; do
            [ "$(dirname "$p")" = "$(dirname "$MY_ROOT")" ] && printf '%s' "$p" && break
          done)
  [ -n "$newer" ] || return 1
  printf '%s' "$(basename "$newer")"
}

while true; do
  if uninstalled; then
    echo "sync: the plugin this monitor was started from has been removed from disk, so it is stopping."
    echo "sync: your claims will NOT be kept alive in this session — start a new session if sync is still installed."
    exit 0
  fi
  if now=$(superseded); then
    # Said in full, because the person reading it has to act: nothing will start
    # a replacement inside this session.
    echo "sync: this session is running the $(basename "$MY_ROOT") plugin monitor, but $now is now installed."
    echo "sync: stopping it rather than letting an old monitor write the credential file the new hooks read."
    echo "sync: your claims will NOT be kept alive in this session — start a new session to pick up $now."
    exit 0
  fi

  # Re-read every pass. See the note above: this is the self-healing property,
  # not laziness. A cached URL is one that cannot be rotated or reissued.
  if [ -r "$WATCH_FILE" ]; then
    url=$(cat "$WATCH_FILE" 2>/dev/null || true)
  else
    # No lease held, so nothing to keep alive. Costing nothing in this state is
    # what makes it acceptable to run always.
    url=""
  fi

  if [ -n "$url" ]; then
    tmp="$TOKEN_DIR/.poll.$$"
    # Rotation is persisted inside sync_poll now, shared with the fence and the
    # resume report. It used to be handled only here, which is precisely why the
    # other two broke the credential.
    # Named, because this is the one poll that proves liveness is working. The
    # gateway records it against the agent and warns on a claim when it has not
    # been heard from; the fence and the resume report poll the same endpoint and
    # must not be mistaken for it.
    code=$(sync_poll "$WATCH_FILE" "$tmp" "sync-monitor")
    body=$(cat "$tmp" 2>/dev/null); rm -f "$tmp"

    if [ "$code" = "410" ]; then
      # A verdict, not a failure: the credential was cleared because another
      # session claimed the item. Said once -- repeating it every two minutes
      # would train people to ignore the channel that carries the one message
      # that matters. Removing the file is what makes it once: the next pass
      # reads no URL and stays quiet.
      #
      # This is now genuinely a verdict again. It briefly had to hedge, because
      # the gateway answered 410 for an aged-out credential too and an agent
      # returning from a weekend was told its work had been taken; that case has
      # its own status below, so this branch can say plainly what it means.
      echo "sync: your claim is no longer yours -- another session took it, or the lease was revoked. Do not continue on it: discard that work, and call 'held' to see where you stand."
      rm -f "$WATCH_FILE"
      # NOT a reason to back off, and this used to set the maximum.
      #
      # Backoff exists for one thing: a gateway that is down must not be polled
      # every two seconds by every open session. That is the `else` branch, and
      # it is right there. This branch has just deleted the credential, so every
      # later pass reads no URL and issues no request at all -- there is nothing
      # left to back off from.
      #
      # What it cost, measured 2026-08-10: only a 200 clears the backoff, and
      # after this branch no request is made, so no 200 can arrive. The monitor
      # latched at 1020s per pass for the rest of the session. The next claim
      # then wrote a fresh credential nothing looked at for 5m11s -- against a
      # default lease TTL of 600s. A single 410, which is an ORDINARY event,
      # left the following lease unwatched for most of its life, which is the
      # collision this whole process exists to prevent.
      BACKOFF=0
    elif [ "$code" = "401" ]; then
      # Ignorance, not a verdict, and the difference is the whole reason this
      # branch exists. The credential aged out because the machine was away
      # longer than a full idle window -- a long weekend, a holiday. Nobody has
      # taken anything, and saying so is the point: this case used to arrive as
      # 410 and told people to discard correct work.
      #
      # Same handling otherwise: say it once, drop the dead credential, and do
      # not back off, because with no file there is nothing left to poll.
      echo "sync: this session's credential expired while you were away, so your claim is no longer being kept alive. Nobody has taken your work -- call 'held' to see where you stand, and re-claim the item if it is still free."
      rm -f "$WATCH_FILE"
      BACKOFF=0
    elif [ "$code" = "200" ]; then
      BACKOFF=0

      # Anything the human or agent needs to know arrives as a line on stdout,
      # which Claude Code delivers into the session as a notification. The
      # gateway decides what is worth saying; this only relays it, so what an
      # agent gets told can change without shipping a new plugin.
      say=$(printf '%s' "$body" | "$SYNC_BIN/sync-json" say)
      [ -n "$say" ] && echo "sync: $say"
    else
      # Could not reach the gateway. Deliberately silent: this is ignorance, not
      # news, and a monitor that narrates its own network trouble trains people
      # to ignore it -- and then it cannot tell them the one thing that matters.
      BACKOFF=$(( BACKOFF == 0 ? 30 : BACKOFF * 2 ))
      [ "$BACKOFF" -gt "$MAX_BACKOFF" ] && BACKOFF=$MAX_BACKOFF
    fi
  fi

  sleep "$(( INTERVAL + BACKOFF ))"
done
