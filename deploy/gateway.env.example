# Copy to deploy/gateway.env and fill in. Do not commit the filled copy.

# Password for the scoped agent_gw Postgres role (set in 000_bootstrap.sql).
GATEWAY_DB_PASSWORD=change-me

# Plane API token belonging to an Admin or Member user. This is the gateway's
# service identity and the ONLY credential that may mutate work item lifecycle.
PLANE_API_KEY=plane_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PLANE_WORKSPACE_SLUG=sync

# Agents close their own work and humans audit afterwards. Set false to require a
# human to close instead.
ALLOW_AGENT_CLOSE=true

SWEEP_INTERVAL_MS=30000
LOG_LEVEL=info
GATEWAY_LISTEN_PORT=8787

# Plane's compose network. Named after the directory its compose file lives in.
PLANE_NETWORK=plane-app_default
